{"checksum": "a6a8ab31ebc530dec5b21dd6a11f0fb522078ab22e2a65d501af75ee6751968ccef2c97a09f2b55fc1755d71af787e728e20976f172e580305f809867096f5be", "code": "import json\nimport os\nimport hashlib\n\ndef update_checksum(filepath):\n    with open(filepath, \"r\") as f:\n        pkg = json.load(f)\n\n    pkg[\"checksum\"] = \"\"\n    # Re-serialize with default spacing\n    pkg_json = json.dumps(pkg)\n    pkg[\"checksum\"] = hashlib.sha512(pkg_json.encode()).hexdigest()\n\n    with open(filepath, \"w\") as f:\n        f.write(json.dumps(pkg))\n    print(f\"Monkey 6 updated ceksum for {os.path.basename(filepath)}!!\")\n\nprint(\"Banan PKGr 1.6\")\n# Build the metadata\nmtd = {\n    \"ver\": input(\"Version: \"),\n    \"name\": input(\"Name: \"),\n    \"type\": \"\",\n    \"dependent\": [],\n    \"installplace\": input(\"Install Place: \"),\n    \"code\": \"\",\n    \"checksum\": \"\" # MUST start as empty string\n}\n\nfn = os.path.realpath(os.path.expanduser(input(\"File to package: \")))\nmtd[\"type\"] = os.path.splitext(fn)[1]\nwith open(fn, \"r\") as f:\n    mtd[\"code\"] = f.read()\n\n# Deterministic Hash Generation\n# Matches the logic in bananhash: hash with checksum as \"\"\npkg_json = json.dumps(mtd) \nmtd[\"checksum\"] = hashlib.sha512(pkg_json.encode()).hexdigest()\n\n# Final output\noutput_fn = f\"{mtd['name']}.banapkg\"\nwith open(output_fn, \"w\") as f:\n    f.write(json.dumps(mtd, sort_keys=True, separators=(',', ':')))\n\n# Scan current directory for .banapkg files\nfor file in os.listdir(\".\"):\n    if file.endswith(\".banapkg\"):\n        update_checksum(file)\n\nprint(f\"Package created! Monkey 6 is happy with {output_fn}\")\n", "dependent": [], "installplace": "/bin", "name": "bananpkgr", "type": ".py", "ver": "1.6"}
