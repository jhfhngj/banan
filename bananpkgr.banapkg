{"checksum":"d415d580ee20385a49dfe42db02032545b2132b773409f20310e2291a238d26a7c28d12c39358669c9b44b0836373f2b120b3ff0109a55b37b569eb24891667b","code":"import json\nimport os\nimport hashlib\n\nmtd = {\n  \"ver\": \"\",\n  \"name\": \"\",\n  \"type\": \"\",\n  \"dependent\": [],\n  \"installplace\": \"\",\n  \"code\": \"\",\n  \"checksum\": \"\"\n}\n\nprint(\"Banan PKGr\")\nprint(\"Where is the file to be packaged?\")\nfn = os.path.realpath(os.path.expanduser(os.path.expandvars(input())))\nmtd[\"type\"] = str(os.path.splitext(fn)[1][1:])\n\ntry:\n    with open(fn) as f:\n        mtd[\"code\"] = f.read()\nexcept FileNotFoundError:\n    print(f\"Error: File not found at {fn}\")\n    exit(1)\n\nprint(\"What shall the package be named? (No spaces)\")\nname = input().replace(\" \", \"\")\nmtd[\"name\"] = name\n\nprint(\"What version is the package?\")\nver = input().replace(\" \", \"\")\nmtd[\"ver\"] = ver\n\nprint(\"What are the dependencies? (Format: dep1,dep2 or leave blank)\")\ndpc_input = input().replace(\" \", \"\")\nif dpc_input:\n    mtd[\"dependent\"] = dpc_input.split(\",\")\n\nprint(\"Where does it install?\")\ninst = input()\nmtd[\"installplace\"] = inst\n\n# --- The fix for checksum and file writing ---\n\n# 1. Temporarily store the original checksum field\noriginal_checksum = mtd.pop(\"checksum\", None)\n\n# 2. Create the JSON string for hashing using deterministic settings\n# Force alphabetical keys and remove all spaces around commas/colons\npkg_json_for_hash = json.dumps(mtd, sort_keys=True, separators=(',', ':'))\n\n# 3. Calculate the checksum\nmtd[\"checksum\"] = hashlib.sha512(pkg_json_for_hash.encode()).hexdigest()\n\n# 4. Save the final file using the EXACT SAME strict formatting used for hashing\n# This ensures the file content matches what the installer expects for verification.\noutput_name = f\"{os.path.splitext(fn)[0]}.banapkg\"\nwith open(output_name, \"w\") as f:\n    f.write(json.dumps(mtd, sort_keys=True, separators=(',', ':')))\n\n# Restore the original checksum field if it existed (though it was likely empty)\nif original_checksum is not None:\n     # This part is technically not needed as we just calculated the checksum,\n     # but included for completeness if the original 'mtd' structure needed to be preserved exactly later.\n     # In this script's flow, 'mtd' is about to go out of scope anyway.\n     pass\n\n\nprint(f\"\\nDone! Package created: {output_name}\")\nprint(f\"Hash: {mtd['checksum']}. Monkey 6 happy\")\n\n","dependent":[],"installplace":"/bin","name":"bananpkgr","type":"py","ver":"1.4"}
