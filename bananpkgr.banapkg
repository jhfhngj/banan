{"checksum": "1ff4e0bc08cd0f8b134e39b17c9a49ae4630d84d15f1c9ffae1150e17f68a25089c32709d3e88addae58bc8a77db05dca86209712757a6d65f17f73c45f48e72", "code": "import json\nimport os\nimport hashlib\n\ndef update_checksum(filepath):\n    with open(filepath, \"r\") as f:\n        pkg = json.load(f)\n\n    pkg[\"checksum\"] = \"\"\n    # Re-serialize with default spacing\n    pkg_json = json.dumps(pkg)\n    pkg[\"checksum\"] = hashlib.sha512(pkg_json.encode()).hexdigest()\n\n    with open(filepath, \"w\") as f:\n        f.write(json.dumps(pkg))\n    print(f\"Monkey 6 updated ceksum for {os.path.basename(filepath)}!!\")\n\nprint(\"Banan PKGr 1.5\")\n# Build the metadata\nmtd = {\n    \"ver\": input(\"Version: \"),\n    \"name\": input(\"Name: \"),\n    \"type\": \"\",\n    \"dependent\": [],\n    \"installplace\": input(\"Install Place: \"),\n    \"code\": \"\",\n    \"checksum\": \"\" # MUST start as empty string\n}\n\nfn = os.path.realpath(os.path.expanduser(input(\"File to package: \")))\nmtd[\"type\"] = os.path.splitext(fn)[1][1:]\nwith open(fn, \"r\") as f:\n    mtd[\"code\"] = f.read()\n\n# Deterministic Hash Generation\n# Matches the logic in bananhash: hash with checksum as \"\"\npkg_json = json.dumps(mtd) \nmtd[\"checksum\"] = hashlib.sha512(pkg_json.encode()).hexdigest()\n\n# Final output\noutput_fn = f\"{mtd['name']}.banapkg\"\nwith open(output_fn, \"w\") as f:\n    f.write(json.dumps(mtd, sort_keys=True, separators=(',', ':')))\n\n# Scan current directory for .banapkg files\nfor file in os.listdir(\".\"):\n    if file.endswith(\".banapkg\"):\n        update_checksum(file)\n\nprint(f\"Package created! Monkey 6 is happy with {output_fn}\")\n", "dependent": [], "installplace": "/bin", "name": "bananpkgr", "type": "py", "ver": "1.6"}
