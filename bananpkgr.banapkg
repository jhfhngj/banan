{"checksum":"e69e95caf43b9c5a9fc49e5386495c365fa90f7d5773c98e4d6ba9e7d8711b80a86b3fb34d5de389f3b305ec0ca516e3a789631342da858229b4666127218ba3","code":"import json\nimport os\nimport hashlib\n\nprint(\"Banan PKGr 1.76\")\n# Build the metadata\nmtd = {\n    \"ver\": input(\"Version: \"),\n    \"name\": input(\"Name: \"),\n    \"type\": \"\",\n    \"dependent\": [],\n    \"installplace\": input(\"Install Place: \"),\n    \"code\": \"\",\n    \"checksum\": \"\" # MUST start as empty string\n}\n\nfn = os.path.realpath(os.path.expanduser(input(\"File to package: \")))\nmtd[\"type\"] = os.path.splitext(fn)[1][1:]\nwith open(fn, \"r\") as f:\n    mtd[\"code\"] = f.read()\n\n# Deterministic Hash Generation\n# Matches the logic in bananhash: hash with checksum as \"\"\npkg_json = json.dumps(mtd) \nmtd[\"checksum\"] = hashlib.sha512(pkg_json.encode()).hexdigest()\n\n# Final output\noutput_fn = f\"{mtd['name']}.banapkg\"\nwith open(output_fn, \"w\") as f:\n    f.write(json.dumps(mtd, sort_keys=True, separators=(',', ':')))\n\nprint(f\"Package created! Monkey 6 is happy with {output_fn}\")\n","dependent":[],"installplace":"/usr/bin/","name":"bananpkgr","type":"py","ver":"1.76"}
