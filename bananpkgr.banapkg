{"checksum":"3290abf9ad0f42de2f80e955358939a3277d1f7e1a0ee6bea968d16c18e279c58e2aacaccf0639e7c153ff6b7bec3652c55162fc87849ce903ce721d4ec2c1bc","code":"import json\nimport os\nimport hashlib\nprint(\"Banan PKGr 1.5\")\n# Build the metadata\nmtd = {\n    \"ver\": input(\"Version: \"),\n    \"name\": input(\"Name: \"),\n    \"type\": \"\",\n    \"dependent\": [],\n    \"installplace\": input(\"Install Place: \"),\n    \"code\": \"\",\n    \"checksum\": \"\" # MUST start as empty string\n}\n\nfn = os.path.realpath(os.path.expanduser(input(\"File to package: \")))\nmtd[\"type\"] = os.path.splitext(fn)[1][1:]\nwith open(fn, \"r\") as f:\n    mtd[\"code\"] = f.read()\n\n# Deterministic Hash Generation\n# Matches the logic in bananhash: hash with checksum as \"\"\npkg_json = json.dumps(mtd, sort_keys=True, separators=(',', ':'))\nmtd[\"checksum\"] = hashlib.sha512(pkg_json.encode()).hexdigest()\n\n# Final output\noutput_fn = f\"{mtd['name']}.banapkg\"\nwith open(output_fn, \"w\") as f:\n    f.write(json.dumps(mtd, sort_keys=True, separators=(',', ':')))\n\nprint(f\"Package created! Monkey 6 is happy with {output_fn}\")\n","dependent":[],"installplace":"/bin","name":"bananpkgr","type":"py","ver":"1.5"}
