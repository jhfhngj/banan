{"checksum": "07351067a360069be99add65a45385d6c3d4d745adf3841574acae3977e0998737f56c96c21527f470111c193cca09204a0fc6862555348a67e6920f043a6394", "code": "#!/usr/bin/python3\nimport requests\nimport json\nimport sys\nimport os\nimport colorama\nimport hashlib\nimport subprocess\n\ncolorama.init()\n\ndef scan_with_clamav(filepath):\n    try:\n        # Monkey 5 does the heavy lifting\n        result = subprocess.run([\"clamscan\", filepath], capture_output=True, text=True)\n        if \"Infected files: 0\" in result.stdout:\n            return True\n        else:\n            print(colorama.Style.BRIGHT + colorama.Fore.RED + colorama.Back.WHITE + \n                  \"\u26a0\ufe0f Monkey 5 think this sus super!!!! ME ANGY!!! ME DESTROY WOLD!!!\")\n            print(result.stdout)\n            return False\n    except Exception as e:\n        print(\"ClamAV scan failed:\", e)\n        return False\n\ndef verify_checksum(content: str, expected_hash: str) -> bool:\n    try:\n        pkg = json.loads(content)\n        pkg[\"checksum\"] = \"\" # Match the bananhash logic\n        \n        # Default Python dumps (Spaced: {\"ver\": \"1.0\", ...})\n        clean_json = json.dumps(pkg) \n        \n        actual_hash = hashlib.sha512(clean_json.encode()).hexdigest()\n        return actual_hash == expected_hash\n    except Exception as e:\n        print(\"Checksum verification failed:\", e)\n        return False\n\ndef install(item: str):\n    try:\n        resp = requests.get(f\"https://jhfhngj.github.io/banan/{item}.banapkg\")\n        resp.raise_for_status()\n    except Exception as e:\n        print(\"Connection failed:\", e)\n        exit(3)\n\n    print(\"Installing \" + item)\n    raw_content = resp.content.decode()\n    print(\"Hit main\")\n    banana = json.loads(raw_content)\n    \n    # Extract metadata\n    ver = banana[\"ver\"]\n    name = banana[\"name\"]\n    tipe = banana[\"type\"]\n    depss = banana[\"dependent\"]\n    loc = banana[\"installplace\"]\n    code = banana[\"code\"]\n    expected_has = banana[\"checksum\"]\n\n    # Verify Checksum before writing\n    #if not verify_checksum(raw_content, expected_has):\n    #    print(colorama.Fore.BLUE + \"Oo oo aa aa! This sussy baka! Monkey 5 disagree!\")\n    #    exit(4)\n\n    # Ensure install directory exists\n    target_dir = os.path.expanduser(loc)\n    os.makedirs(target_dir, exist_ok=True)\n\n    print(\"Writing file\")\n\n    # Write the file\n    filename = f\"{name}_{ver}.{tipe}\" if tipe else f\"{name}_{ver}\"\n    filepath = os.path.join(target_dir, filename)\n    \n    with open(filepath, \"w\") as f:\n        f.write(code)\n    \n    print(\"Wrote file\")\n\n    # Monkey 5 Scan\n    if not scan_with_clamav(filepath):\n        os.remove(filepath)\n        print(\"Removed file\")\n        exit(5)\n\n    # Dependencies\n    if depss:\n        for dep in depss:\n            install(dep)\n            \n    print(f\"Installed {item} at {loc}\")\n\n# Entry Point\nif len(sys.argv) > 1:\n    cmd = sys.argv[1].lower()\n    if cmd == \"install\" and len(sys.argv) > 2:\n        install(sys.argv[2])\n    else:\n        print(\"banan install <package>\")\nelse:\n    print(\"No inputs!\")\n", "dependent": [], "installplace": "/bin", "name": "bananclient", "type": "py", "ver": "1.7"}
